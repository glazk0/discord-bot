{
  "name": "discord-bot",
  "version": "0.0.0",
  "private": true,
  "description": "Opinionated TypeScript boilerplate for Discord bots — discord.js, Drizzle/Postgres, Redis cache, i18n, sharding.",
  "type": "module",
  "imports": {
    "#cache/*": "./src/cache/*.ts",
    "#commands/*": "./src/commands/*.ts",
    "#components/*": "./src/components/*.ts",
    "#config/*": "./src/config/*.ts",
    "#core/*": "./src/core/*.ts",
    "#cron/*": "./src/cron/*.ts",
    "#database/*": "./src/database/*.ts",
    "#events/*": "./src/events/*.ts",
    "#i18n/*": "./src/i18n/*.ts",
    "#jobs/*": "./src/jobs/*.ts"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "lefthook install",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "commands:deploy": "tsx --env-file-if-exists=.env src/scripts/deploy-commands.ts"
  },
  "dependencies": {
    "bullmq": "^6.3.8",
    "croner": "^10.0.1",
    "discord.js": "^14.27.0",
    "drizzle-orm": "^0.45.2",
    "glob": "^13.0.6",
    "i18next": "^26.4.2",
    "i18next-fs-backend": "^2.6.8",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.12",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "pino-pretty": "^13.1.3",
    "tsc-alias": "^1.9.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@11.25.0"
}
